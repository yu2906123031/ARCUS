# Arcus BTC live trading credentials. Fill locally; never share this file.
# Ethereum address that owns the registered Arcus API key.
ARCUS_ADDRESS=

# Registered Ed25519 API seed: 64 hex characters (32 bytes).
# This is NOT your Ethereum wallet private key.
ARCUS_API_PRIVATE_KEY=

# Dedicated Arcus subaccount index: 0 through 9.
ARCUS_ACCOUNT_INDEX=0
